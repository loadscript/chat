{
    "name": "@loadscript/chat",
    "version": "1.0.2",
    "description": "Chat application package for the loadscript harness.",
    "type": "module",
    "main": "./src/index.ts",
    "module": "./src/index.ts",
    "types": "./src/index.ts",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "default": "./src/index.ts"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "src",
        "!src/**/*.test.ts",
        "!src/**/*.test.tsx",
        "!src/**/*.spec.ts",
        "!src/**/*.spec.tsx",
        "!src/**/*.stories.tsx",
        "!src/**/__snapshots__/**"
    ],
    "engines": {
        "node": ">=18"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/loadscript/chat.git"
    },
    "homepage": "https://github.com/loadscript/chat#readme",
    "bugs": {
        "url": "https://github.com/loadscript/chat/issues"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org"
    },
    "scripts": {
        "dev": "vite --host",
        "build": "vite build",
        "preview": "vite preview",
        "test": "vitest run --passWithNoTests",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit"
    },
    "author": "NQQT",
    "license": "ISC",
    "dependencies": {
        "@loadscript/harness": "*",
        "@presource/core": "*",
        "@rightless/icons": "*",
        "@underload/dashboard": "*",
        "@underload/harness": "*",
        "react": "^18.2.0",
        "react-dom": "^18.2.0"
    },
    "devDependencies": {
        "@presource/react": "*",
        "@presource/test": "*",
        "@storybook/react": "^10.0.0",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/react": "^16.3.2",
        "@types/node": "^25.9.1",
        "@types/react": "^18.2.0",
        "@types/react-dom": "^18.2.0",
        "@vitejs/plugin-react": "^6.0.1",
        "jsdom": "^29.0.2",
        "typescript": "^6.0.0",
        "vite": "^8.0.8",
        "vitest": "^4.1.4"
    }
}
